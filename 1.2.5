#this script assumes tidyverse is already installed and loaded...
library(tidyverse)
library(palmerpenguins)
library(ggthemes) #offers colorblind safe palette

#this ggplot uses the penguins tibble as data
#it uses the aesthetic function in the mapping function in the ggplot function
#to map it all out 
#geom point adds the layer of points
#geom smooth adds a curve to the points
#since the points are separated by color in the mapping function
#, geom_smooth will act on each grouping independently

ggplot(
  data = penguins,
  mapping = aes(x = flipper_length_mm, y = body_mass_g, color = species)
  ) + 
  geom_point() +
  geom_smooth(method = "lm")

#this ggplot makes a whole line for all the data points while keeping
#the data points separately colored and identifiable
#this is because the aesthetic function is called under the 
#geom_point function here
#we also add the shape function under the aes function to 
#change the shape of the points to make it more viewer friendly

ggplot(
  data = penguins,
  mapping = aes(x = flipper_length_mm, y = body_mass_g)
) +
  geom_point(mapping = aes(color = species, shape = species)) +
  geom_smooth(method = "lm")

