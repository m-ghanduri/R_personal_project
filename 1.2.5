#the issue is that there are no variables assigned to x or y values...

#What does the na.rm argument do in geom_point()? 
#What is the default value of the argument? 
#Create a scatterplot where you successfully use this argument set to TRUE.

ggplot(
  data = penguins,
  mapping = aes(x = bill_length_mm, y = bill_depth_mm)
) + 
  geom_point(na.rm = T)
#na.rm removes the error message for missing variables but still removes the values

#recreate a visualization

ggplot(data = penguins,
       mapping = aes(x = flipper_length_mm, y = body_mass_g)
       ) + 
