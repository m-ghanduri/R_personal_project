#Make a scatterplot of hwy vs. displ using the mpg data frame. 
#Next, map a third, numerical variable to color, then size, then both color and size, then shape. 
#How do these aesthetics behave differently for categorical vs. numerical variables?

ggplot(mpg, aes(x = hwy, y = displ)) + 
  geom_point()

#cyl mapped to colour
ggplot(mpg, aes(x = hwy, y = displ)) + 
  geom_point(aes(colour = cyl))

#cyl mapped to size
ggplot(mpg, aes(x = hwy, y = displ)) + 
  geom_point(aes(size = cyl))

#cyl mapped to both size and colour
ggplot(mpg, aes(x = hwy, y = displ)) + 
  geom_point(aes(colour = cyl, size = cyl))

#cyl attempted to map to shape; this doesn't work because I'm trying to 
#map a continous variable on a discrete mapping aesthetic
ggplot(mpg, aes(x = hwy, y = displ)) + 
  geom_point(aes(shape = cyl))

#In the scatterplot of hwy vs. displ, what happens if you map a third variable to linewidth?
ggplot(mpg, aes(x = hwy, y = displ, linewidth = manufacturer)) +
  geom_point()
#nothing seems to happen... whether the variable is categorical or a number

#Make a scatterplot of bill_depth_mm vs. bill_length_mm and color the points by species.
#What does adding coloring by species reveal about the relationship between these two variables? 
#What about faceting by species?

ggplot(penguins, aes(x = bill_depth_mm, y = bill_length_mm, colour = species)) + 
  geom_point()

ggplot(penguins, aes(x = bill_depth_mm, y = bill_length_mm, colour = species)) + 
  geom_point() + 
  facet_wrap(~species)

#the trend is the same for both faceting and not faceting by species, which is that
#there is a positive trend with seemingly around the same slope between bill depth
#and length in all three species. However, the y intercept is different and is shown
#better in a scatterplot with all three in one graph rather than faceting


#Why does the following yield two separate legends? How would you fix it to combine the two legends?

ggplot(
  data = penguins,
  mapping = aes(
    x = bill_length_mm, y = bill_depth_mm, 
    color = species, shape = species
  )
) +
  geom_point() +
  labs(color = "Species")

# you can fix it by adding the shape variable to species as well in the label
ggplot(
     data = penguins,
     mapping = aes(
         x = bill_length_mm, y = bill_depth_mm
     )
 ) +
     geom_point(aes(color = species, shape = species)) +
     labs(color = "Species", shape = "Species")

#Create the two following stacked bar plots. 
#Which question can you answer with the first one? 
#Which question can you answer with the second one?
ggplot(penguins, aes(x = island, fill = species)) +
  geom_bar(position = "fill")
ggplot(penguins, aes(x = species, fill = island)) +
  geom_bar(position = "fill")

#the first one seems to be answering, which species live on each island and 
#what are their relative ratios on each island?
#the second one seems to be answering, how are the species geographically distributed?
